---
import Band from '@src/components/Band.astro';
import CtaButton from '@src/components/CtaButton.astro';
import ThroughLine from '@src/components/experience/ThroughLine.astro';
import Scribble from '@src/components/marks/Scribble.astro';
import { site } from '@src/data/site';

const contacts = [
  { label: site.email, href: `mailto:${site.email}` },
  { label: 'github', href: site.links.github },
  { label: 'linkedin', href: site.links.linkedin },
];

// A curve from the note up to the panel's bottom edge, with its arrowhead.
const arrow = 'M152,60 C116,66 66,56 30,18 M48,22 C40,18 30,13 24,10 C25,18 27,28 29,36';
---

<Band ground="paper" graph class="hero">
  <div class="container grid">
    <div class="intro">
      <h1 class="vh">{site.name} — Experience</h1>
      <p class="display">
        <span class="line">I get paid</span>
        <span class="line">to delete</span>
        <span class="line">the manual</span>
        <span class="line step">step.</span>
      </p>
      <p class="lead">
        Forward deployed engineer at {site.employer.name} — in the room with the client first, then
        frontend, backend and the CI/CD in between. Three roles since 2024: different companies,
        different stacks, and the same shape of problem underneath every one of them.
      </p>
      <ul class="contacts">
        {contacts.map(({ label, href }, index) => <li>
          <a href={href}>{label}</a>
          {index < contacts.length - 1 && <span class="sep" aria-hidden="true">/</span>}
        </li>)}
      </ul>
    </div>

    <div class="exhibit">
      <ThroughLine />
      <p class="note">
        <span class="note-text">I noticed it late — the same problem, four times over.</span>
        <Scribble class="note-arrow" d={arrow} width={160} height={72} />
      </p>
    </div>

    <CtaButton
      class="cta"
      href={site.resumePdf}
      direction="down"
      bleed
      download="ahmed-sozzer-resume.pdf"
      >Download the PDF<span class="vh">{' of my résumé'}</span></CtaButton
    >
  </div>
</Band>

<style>
  .hero {
    min-block-size: calc(100svh - var(--layout-header-height) - var(--layout-amber-band));
    padding-block: var(--space-xl) 0;
  }
  
  .grid {
    display: grid;
    gap: var(--space-xl);
  }
  
  .line {
    display: block;
  }
  
  .step {
    inline-size: fit-content;
    margin-inline-start: calc(var(--space-2xs) * -1);
    padding-inline: var(--space-2xs);
    background-color: var(--color-amber);
  }
  
  .lead {
    max-inline-size: var(--layout-prose-max);
    margin-block-start: var(--space-l);
    color: var(--fg-body);
  }
  
  .contacts {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--space-s);
    margin-block-start: var(--space-xs);
    padding: 0;
    font-family: var(--font-mono);
    font-size: var(--size-mono);
    line-height: var(--leading-mono);
    list-style: none;
  }
  
  .contacts li {
    display: flex;
    gap: var(--space-s);
    align-items: baseline;
  }
  
  /* 12px of padding each way makes the 44px touch target. */
  .contacts a {
    display: inline-block;
    padding-block: var(--space-xs);
    color: var(--fg);
    text-decoration-thickness: var(--rule-figure);
    text-underline-offset: var(--space-2xs);
  }
  
  .contacts a:hover {
    text-decoration-color: var(--color-amber);
  }
  
  .sep {
    color: var(--rule-color);
  }
  
  .note {
    position: relative;
    margin-block-start: var(--space-m);
    color: var(--fg-secondary);
    font-family: var(--font-mono);
    font-size: var(--size-note);
    font-style: italic;
    line-height: var(--leading-mono);
  }
  
  .note-text {
    display: inline-block;
    rotate: -0.6deg;
  }
  
  .note-arrow {
    display: none;
  }
  
  /* Phone: the button runs edge to edge and sits flush on the amber band. */
  .cta {
    margin-inline: calc(var(--layout-gutter) * -1);
  }
  
  /* Desktop: copy left, the panel cropping past the right edge, the button hanging over the band. */
  @media (width >= 64rem) {
    .hero {
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-block-size: calc(100svh - var(--layout-header-height) - var(--layout-amber-band));
    }
  
    .grid {
      flex-grow: 1;
      grid-template:
        'intro exhibit' auto
        'cta exhibit' 1fr
        / minmax(0, 1fr) minmax(0, 1.1fr);
      column-gap: var(--space-2xl);
    }
  
    .intro {
      grid-area: intro;
    }
  
    .exhibit {
      grid-area: exhibit;
      margin-inline-end: calc(var(--layout-gutter) * -1);
      padding-block-start: var(--space-l);
    }
  
    /* Indented so the scribble can reach back up to the panel, and pulled in at the end because the panel bleeds. */
    .note {
      margin-block-start: var(--space-xl);
      margin-inline: calc(var(--space-4xl) + var(--space-xl)) var(--layout-gutter);
    }
  
    .note-text {
      rotate: -2deg;
    }
  
    .note-arrow {
      display: block;
      inset-block-start: calc(var(--space-xl) * -1);
      inset-inline-end: calc(100% + var(--space-2xs));
      inline-size: calc(var(--space-4xl) + var(--space-l));
    }
  
    .cta {
      position: relative;
      z-index: 2;
      grid-area: cta;
      place-self: end start;
      margin-block-end: calc((var(--layout-amber-band) + var(--space-m)) * -1);
      margin-inline: 0;
    }
  }
  
  @media print {
    .hero {
      min-block-size: auto;
      padding-block: 0;
    }
  
    .grid {
      display: block;
    }
  
    .display {
      font-size: var(--size-h3);
    }
  
    .lead {
      max-inline-size: none;
      margin-block-start: var(--space-s);
      font-size: var(--size-small);
    }
  
    .contacts {
      margin-block-start: 0;
    }
  
    .contacts a {
      padding-block: 0;
    }
  
    .hero .exhibit,
    .hero .cta {
      display: none;
    }
  }
</style>
