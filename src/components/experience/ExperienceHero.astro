---
import Band from '@src/components/Band.astro';
import CtaButton from '@src/components/CtaButton.astro';
import ThroughLine from '@src/components/experience/ThroughLine.astro';
import { site } from '@src/data/site';

const contacts = [
  { label: site.email, href: `mailto:${site.email}` },
  { label: 'github', href: site.links.github },
  { label: 'linkedin', href: site.links.linkedin },
];
---

<Band ground="paper" graph class="hero" data-motion-hero>
  <div class="container grid">
    <div class="intro">
      <h1 class="vh">{site.name} · Experience</h1>
      <p class="display" data-motion>
        <span class="line">I get paid</span>
        <span class="line">to delete</span>
        <span class="line">the manual</span>
        <span class="line">step.</span>
      </p>
      <p class="lead">
        Full-stack engineer at {site.employer.name}, a studio that builds products for startups. I
        work with the founders and the people using what we ship, and build the frontend, the
        backend and the pipeline that ships them. Three roles since 2024, and the same shape of
        problem in each.
      </p>
      <ul class="contacts">
        {contacts.map(({ label, href }, index) => <li>
          <a href={href}>{label}</a>
          {index < contacts.length - 1 && <span class="sep" aria-hidden="true">/</span>}
        </li>)}
      </ul>
    </div>

    <div class="exhibit">
      <ThroughLine />
      <p class="note">I noticed it late: the same problem, five times over.</p>
    </div>

    <CtaButton
      class="cta"
      href={site.resumePdf}
      direction="down"
      bleed
      download="ahmed-sozzer-resume.pdf"
      >Download the PDF<span class="vh">{' of my résumé'}</span></CtaButton
    >
  </div>
</Band>

<style>
  .hero {
    min-block-size: calc(100svh - var(--layout-header-height) - var(--layout-amber-band));
    padding-block: var(--space-xl) 0;
  }
  
  .grid {
    display: grid;
    gap: var(--space-xl);
  }
  
  .line {
    display: block;
  }
  
  .lead {
    max-inline-size: var(--layout-prose-max);
    margin-block-start: var(--space-l);
    color: var(--fg-body);
  }
  
  .contacts {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--space-s);
    margin-block-start: var(--space-xs);
    padding: 0;
    font-family: var(--font-mono);
    font-size: var(--size-mono);
    line-height: var(--leading-mono);
    list-style: none;
  }
  
  .contacts li {
    display: flex;
    gap: var(--space-s);
    align-items: baseline;
  }
  
  /* 12px of padding each way makes the 44px touch target. */
  .contacts a {
    display: inline-block;
    padding-block: var(--space-xs);
    color: var(--fg);
    text-decoration-thickness: var(--rule-figure);
    text-underline-offset: var(--space-2xs);
  }
  
  .contacts a:hover {
    text-decoration-color: var(--color-amber);
  }
  
  .sep {
    color: var(--rule-color);
  }
  
  .note {
    position: relative;
    margin-block-start: var(--space-m);
    color: var(--fg-secondary);
    font-family: var(--font-mono);
    font-size: var(--size-note);
    font-style: italic;
    line-height: var(--leading-mono);
  }
  
  /* Phone: the button runs edge to edge and sits flush on the amber band. */
  .cta {
    margin-inline: calc(var(--layout-gutter) * -1);
  }
  
  /* Desktop: copy left, the panel cropping past the right edge, the button hanging over the band. */
  @media (width >= 64rem) {
    .hero {
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-block-size: calc(100svh - var(--layout-header-height) - var(--layout-amber-band));
    }
  
    .grid {
      grid-template:
        'intro exhibit' auto
        'cta exhibit' 1fr
        / minmax(0, 1fr) minmax(0, 1.1fr);
      column-gap: var(--space-2xl);
    }
  
    .intro {
      grid-area: intro;
    }
  
    .exhibit {
      grid-area: exhibit;
      margin-inline-end: calc(var(--layout-gutter) * -1);
      padding-block-start: var(--space-l);
    }
  
    .note {
      margin-block-start: var(--space-xl);
      margin-inline-end: var(--layout-gutter);
    }
  
    .cta {
      position: relative;
      z-index: 2;
      grid-area: cta;
      place-self: end start;
      margin-block-end: calc((var(--layout-amber-band) + var(--space-m)) * -1);
      margin-inline: 0;
    }
  }
  
  @media print {
    .hero {
      min-block-size: auto;
      padding-block: 0;
    }
  
    .grid {
      display: block;
    }
  
    .display {
      font-size: var(--size-h3);
    }
  
    .lead {
      max-inline-size: none;
      margin-block-start: var(--space-s);
      font-size: var(--size-small);
    }
  
    .contacts {
      margin-block-start: 0;
    }
  
    .contacts a {
      padding-block: 0;
    }
  
    .hero .exhibit,
    .hero .cta {
      display: none;
    }
  }
</style>
