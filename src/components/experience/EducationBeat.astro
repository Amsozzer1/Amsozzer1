---
import ArrowLink from '@src/components/ArrowLink.astro';
import Band from '@src/components/Band.astro';
import Kicker from '@src/components/Kicker.astro';
import resume from '@src/data/resume.json';
import { monthYear } from '@src/lib/dates';

interface Props {
  number: string;
}

const { number } = Astro.props;
const [uiuc, wright] = resume.education;
const [paper, neiu, wrightTalk] = resume.publications;

const year = (date: string) => date.slice(0, 4);
const graduated = uiuc.endDate ? monthYear(uiuc.endDate) : '';

const talks = [
  { place: 'NEIU', page: 'symposium listing', talk: neiu },
  { place: 'Wright College', page: 'colloquium programme (PDF)', talk: wrightTalk },
];

// Wright comes first: it is where the research started, and UIUC followed from it.
const wrightDegree = [wright.abbreviation, wright.score].filter(Boolean).join(', ');
---

<Band ground="paper" labelledby="education" class="beat">
  <div class="container grid">
    <hgroup class="heading">
      <Kicker>{number} <span aria-hidden="true">·</span> education</Kicker>
      <h2 id="education" class="title">Education</h2>
      <p class="intro">A CS degree, and the research that came before it.</p>
    </hgroup>

    <div class="schools">
      <div class="school">
        <div class="school-head">
          <h3 class="name">{wright.institution}</h3>
          <p class="degree">{wrightDegree}</p>
        </div>
        <p class="paper">
          I started at a two-year school and became the college’s first computer science tutor,
          teaching calculus, physics, chemistry and two semesters of C. That is how Dr. Espiritu
          found me and put me on her research into matching mentors with mentees. I co-authored the
          first version of the paper and presented it at Wright College in
          {year(wrightTalk.releaseDate)} and at NEIU in {year(neiu.releaseDate)}, and the published
          <a href={paper.url}>ASEE work-in-progress paper<span class="vh">{' (PDF)'}</span></a>
          acknowledges me by name.
        </p>
        <ul class="talks">
          {talks.map(({ place, page, talk }) => <li>
            <ArrowLink
              href={talk.url}
              label={`${place}, ${year(talk.releaseDate)}`}
              direction="up-right"
              aria-label={`${place}, ${year(talk.releaseDate)}: ${page}`}
            />
          </li>)}
        </ul>
      </div>

      <div class="school">
        <div class="school-head">
          <h3 class="name">{uiuc.institution}</h3>
          <p class="degree">
            <abbr title={uiuc.studyType}>{uiuc.abbreviation}</abbr>
            {uiuc.area} <span aria-hidden="true">·</span>
            {graduated}
          </p>
        </div>
        <p class="paper">Transferred from Wright with a cohort of friends.</p>
      </div>
    </div>
  </div>
</Band>

<style>
  .grid {
    display: grid;
    gap: var(--space-l);
  }
  
  .heading {
    display: grid;
    gap: var(--space-s);
  }
  
  .title {
    font-size: var(--size-h3);
  }
  
  .schools {
    display: grid;
    gap: var(--space-xl);
  }
  
  .school {
    padding-block-start: var(--space-m);
    border-block-start: var(--rule-major) solid var(--fg);
  }
  
  .school-head {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s) var(--space-m);
    align-items: baseline;
    justify-content: space-between;
  }
  
  .name {
    font-size: var(--size-h3);
    font-weight: 700;
    line-height: var(--leading-heading);
  }
  
  .degree {
    color: var(--color-text-body);
    font-family: var(--font-mono);
    font-size: var(--size-mono);
    line-height: var(--leading-mono);
  }
  
  abbr {
    text-decoration: none;
  }
  
  .paper {
    max-inline-size: var(--layout-prose-max);
    margin-block-start: var(--space-m);
  }
  
  .paper a {
    text-decoration-color: var(--prose-underline-color);
    text-decoration-thickness: var(--rule-figure);
  }
  
  .paper a:hover {
    text-decoration-color: currentcolor;
  }
  
  .talks {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s) var(--space-l);
    margin-block-start: var(--space-m);
    padding: 0;
    list-style: none;
  }
  
  @media (width >= 64rem) {
    .grid {
      grid-template-columns: minmax(0, 2fr) minmax(0, 5fr);
      column-gap: var(--space-2xl);
      align-items: start;
    }
  }
  
  @media print {
    .beat {
      padding-block: var(--space-s);
    }
  
    .grid {
      display: block;
    }
  
    .school {
      margin-block-start: var(--space-s);
    }
  
    .title,
    .name {
      font-size: var(--size-h4);
    }
  
    .paper {
      max-inline-size: none;
      font-size: var(--size-small);
    }
  }
</style>
