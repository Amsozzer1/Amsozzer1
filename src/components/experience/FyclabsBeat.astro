---
import Band from '@src/components/Band.astro';
import StackList from '@src/components/StackList.astro';
import BeatKicker from '@src/components/experience/BeatKicker.astro';
import SameJobStories from '@src/components/experience/SameJobStories.astro';
import { alsoAtFyclabs, tracks } from '@src/components/experience/_helpers/fyclabsBeat.consts';
import type resume from '@src/data/resume.json';

interface Props {
  job: (typeof resume.work)[number];
  number: string;
}

const { job, number } = Astro.props;
const id = `job-${number}`;
const focus = job.summary ? `. ${job.summary}` : '';

// The stack line for each track is the one on the résumé, so the two cannot drift.
const stackOf = (name: string) => job.tracks?.find(track => track.name === name)?.stack ?? '';

const stack = [
  'Next.js',
  'React',
  'TypeScript',
  'PostgreSQL + Prisma',
  'GCP',
  'React Native',
  'REST & webhooks',
];
---

<section class="job" aria-labelledby={id}>
  <Band ground="body" class="beat">
    <div class="container">
      <div class="head">
        <hgroup class="heading">
          <BeatKicker
            number={number}
            place={job.location}
            start={job.startDate}
            end={job.endDate}
          />
          <h2 id={id} class="company">{job.name}</h2>
          <p class="position">{job.position}{focus}</p>
        </hgroup>
        <StackList items={stack} class="stack" />
      </div>

      <div class="body">
        {tracks.map(track => <section class="track" aria-labelledby={track.id}>
          <h3 id={track.id} class="track-name">{track.name}</h3>
          <p class="track-stack">{stackOf(track.name)}</p>
          {track.heading && <h4 class="track-heading">{track.heading}</h4>}
          {track.paragraphs.map(paragraph => <p class="track-text">{paragraph}</p>)}
        </section>)}

        <section class="track" aria-labelledby="also">
          <h3 id="also" class="track-name">Also at FYCLabs</h3>
          <p class="track-text">{alsoAtFyclabs}</p>
        </section>
      </div>
    </div>
  </Band>
  <SameJobStories />
</section>

<style>
  .head {
    display: grid;
    gap: var(--space-s);
  }
  
  .heading {
    display: grid;
    gap: var(--space-2xs);
  }
  
  .company {
    font-size: var(--size-h2);
  }
  
  .position {
    color: var(--fg-body);
    font-size: var(--size-lead);
    line-height: var(--leading-tight);
  }
  
  .body {
    display: grid;
    gap: var(--space-xl);
    margin-block-start: var(--space-xl);
  }
  
  .track {
    padding-block-start: var(--space-m);
    border-block-start: var(--rule-row) solid var(--rule-color);
  }
  
  .track-name {
    font-size: var(--size-h4);
  }
  
  .track-stack {
    margin-block-start: var(--space-3xs);
    color: var(--fg-caption);
    font-family: var(--font-mono);
    font-size: var(--size-mono-small);
    line-height: var(--leading-mono);
  }
  
  .track-heading {
    margin-block-start: var(--space-m);
    color: var(--fg);
    font-family: var(--font-body);
    font-size: var(--size-small);
    font-weight: 600;
  }
  
  .track-text {
    max-inline-size: var(--layout-prose-max);
    margin-block-start: var(--space-s);
    color: var(--fg-body);
  }
  
  @media (width >= 64rem) {
    .head {
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: var(--space-xl);
      align-items: end;
    }
  
    .stack {
      justify-content: flex-end;
      max-inline-size: calc(var(--space-4xl) * 2);
      text-align: end;
    }
  
    .track {
      display: grid;
      grid-template-columns: minmax(0, 4fr) minmax(0, 9fr);
      column-gap: var(--space-2xl);
    }
  
    .track-stack {
      grid-column: 1;
    }
  
    .track-name {
      grid-column: 1;
      grid-row: 1;
    }
  
    .track-heading,
    .track-text {
      grid-column: 2;
    }
  
    .track-heading:first-of-type,
    .track-text:first-of-type {
      margin-block-start: 0;
    }
  }
  
  @media print {
    .track {
      break-inside: avoid;
    }
  }
</style>
