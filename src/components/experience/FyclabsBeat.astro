---
import Band from '@src/components/Band.astro';
import StackList from '@src/components/StackList.astro';
import BeatKicker from '@src/components/experience/BeatKicker.astro';
import SameJobStories from '@src/components/experience/SameJobStories.astro';
import type resume from '@src/data/resume.json';

interface Props {
  job: (typeof resume.work)[number];
  number: string;
}

const { job, number } = Astro.props;
const id = `job-${number}`;
const focus = job.summary ? ` — ${job.summary.charAt(0).toLowerCase()}${job.summary.slice(1)}` : '';

const stack = [
  'Next.js',
  'React',
  'TypeScript',
  'PostgreSQL + Prisma',
  'GCP',
  'React Native',
  'REST & webhooks',
];
---

<section class="job" aria-labelledby={id}>
  <Band ground="body" class="beat">
    <div class="container">
      <div class="head">
        <hgroup class="heading">
          <BeatKicker
            number={number}
            place={job.location}
            start={job.startDate}
            end={job.endDate}
          />
          <h2 id={id} class="company">{job.name}</h2>
          <p class="position">{job.position}{focus}</p>
        </hgroup>
        <StackList items={stack} class="stack" />
      </div>

      <div class="body">
        <dl class="highlights">
          {job.tracks?.map(track => <div class="row">
            <dt>{track.name}</dt>
            <dd>
              <p class="track-stack">{track.stack}</p>
              <ul class="track-points">
                {track.highlights.map(point => <li>{point}</li>)}
              </ul>
            </dd>
          </div>)}
        </dl>
      </div>
    </div>
  </Band>
  <SameJobStories />
</section>

<style>
  .head {
    display: grid;
    gap: var(--space-s);
  }
  
  .heading {
    display: grid;
    gap: var(--space-xs);
  }
  
  .position {
    color: var(--fg-body);
    font-size: var(--size-lead);
    line-height: var(--leading-tight);
  }
  
  .body {
    display: grid;
    gap: var(--space-xl);
    margin-block-start: var(--space-xl);
  }
  
  .row {
    padding-block: var(--space-s);
    border-block-start: var(--rule-row) solid var(--rule-color);
  }
  
  .row:last-child {
    padding-block-end: 0;
  }
  
  dt {
    color: var(--fg);
    font-weight: 600;
    line-height: var(--leading-tight);
  }
  
  dd {
    margin-block-start: var(--space-2xs);
    color: var(--fg-body);
    font-size: var(--size-small);
  }
  
  @media (width >= 48rem) {
    .row {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      gap: var(--space-m);
      align-items: baseline;
    }
  
    dd {
      margin-block-start: 0;
    }
  }
  
  @media (width >= 64rem) {
    .head {
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: var(--space-xl);
      align-items: end;
    }
  
    .stack {
      justify-content: flex-end;
      max-inline-size: calc(var(--space-4xl) * 2);
      text-align: end;
    }
  
    .body {
      grid-template-columns: minmax(0, 5fr) minmax(0, 9fr);
      column-gap: var(--space-2xl);
      align-items: start;
    }
  }
  
  @media print {
    .beat {
      padding-block: var(--space-s);
    }
  
    .company {
      font-size: var(--size-h3);
    }
  
    .position {
      font-size: var(--size-small);
    }
  
    .body {
      display: block;
      margin-block-start: var(--space-s);
    }
  
    .track-stack {
      color: var(--color-text-caption);
      font-family: var(--font-mono);
      font-size: var(--size-mono-small);
      line-height: var(--leading-mono);
    }
  
    .track-points {
      margin-block-start: var(--space-2xs);
      padding-inline-start: var(--space-m);
    }
  
    .track-points li + li {
      margin-block-start: var(--space-2xs);
    }
  
    .highlights {
      margin-block-start: var(--space-s);
    }
  
    .row {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      gap: var(--space-m);
      padding-block: var(--space-2xs);
      align-items: baseline;
      break-inside: avoid;
    }
  
    dd {
      margin-block-start: 0;
    }
  }
</style>
