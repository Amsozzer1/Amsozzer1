---
interface Props {
  class?: string;
}

const { class: className, ...rest } = Astro.props;

const shifts = [
  {
    before: 'component prices re-calibrated by hand',
    after: 'an ML pricing model on live supplier data',
  },
  {
    before: 'an insurance carrier silently dropping policy photos',
    after: 'nightly jobs that catch and resubmit them',
  },
  {
    before: 'students and staff signing in to seven portals',
    after: 'one sign-on in front of all of them, 50,000+ people a day',
  },
  {
    before: 'an operations team retyping between systems',
    after: 'CRM integrations that do the typing',
  },
  {
    before: 'a filament swap at every material change',
    after: 'AMS-X, on my own time',
  },
];
---

<div class:list={['through-line', className]} {...rest}>
  <p class="label">the through-line <span class="meta">three jobs, and one on my own time</span></p>
  <ul class="shifts">
    {shifts.map(({ before, after }) => <li class="shift">
      <span class="before">{before}</span>
      <span class="arrow">→</span>
      <span class="after">{after}</span>
    </li>)}
  </ul>
</div>

<style>
  .through-line {
    padding-block-start: var(--space-s);
    border-block-start: var(--rule-major) solid var(--color-text);
  }
  
  .label {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    justify-content: space-between;
    color: var(--fg-caption);
    font-family: var(--font-mono);
    font-size: var(--size-mono);
    line-height: var(--leading-mono);
  }
  
  .shifts {
    container-type: inline-size;
    padding: 0;
    font-family: var(--font-body);
    font-size: var(--size-small);
    line-height: var(--leading-tight);
    list-style: none;
  }
  
  /* Narrow panel: the old way on one line, the arrow and the new way under it. */
  .shift {
    display: grid;
    grid-template-areas:
      'before before'
      'arrow after';
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-3xs) var(--space-2xs);
    padding-block: var(--space-xs);
    border-block-end: var(--rule-row) solid var(--rule-color);
  }
  
  .shift:last-child {
    border-block-end: 0;
  }
  
  .before {
    grid-area: before;
    color: var(--fg-body);
  }
  
  .arrow {
    grid-area: arrow;
    color: var(--color-amber);
    font-family: var(--font-mono);
    font-size: var(--size-mono);
  }
  
  .after {
    grid-area: after;
    color: var(--fg);
  }
  
  @container (width >= 30rem) {
    .shift {
      grid-template-areas: 'before arrow after';
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      gap: var(--space-xs);
      align-items: baseline;
    }
  }
</style>
