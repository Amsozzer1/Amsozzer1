---
import Band from '@src/components/Band.astro';
import BeatKicker from '@src/components/experience/BeatKicker.astro';
import RoleLine from '@src/components/experience/RoleLine.astro';
import Stat from '@src/components/experience/Stat.astro';
import { facts } from '@src/data/facts';
import type resume from '@src/data/resume.json';

interface Props {
  job: (typeof resume.work)[number];
  number: string;
}

const { job, number } = Astro.props;
const id = `job-${number}`;
---

<Band ground="body" labelledby={id} class="beat">
  <div class="container">
    <hgroup class="heading">
      <BeatKicker number={number} place={job.location} start={job.startDate} end={job.endDate} />
      <h2 id={id} class="headline">
        <span class="vh">{`${job.name}: `}</span>A price list that was being re-calibrated by hand.
      </h2>
    </hgroup>

    <div class="grid">
      <div class="story">
        <p>
          At Luminii, component costs moved with supplier data and somebody adjusted them by hand. I
          built an ML-driven pricing system that took the live feed and did it instead — the first
          time I replaced a person’s recurring task with a system, and the reason I now look for
          that shape first.
        </p>
        <p>
          The pricing pipeline sat on a database that had grown past its indexes, so that came with
          it: a reindex and automated data validation underneath, which is what actually made the
          query times usable.
        </p>
      </div>
      <Stat class="record-count" value={facts.experience.luminii.records}>
        records reindexed, with automated validation added on top — cutting query times across the
        pricing pipeline.
      </Stat>
      <RoleLine
        class="role"
        position={job.position}
        company={job.name}
        stack={['Python', 'SQL', 'ML']}
      />
    </div>
  </div>
</Band>

<style>
  .heading {
    display: grid;
    gap: var(--space-s);
  }
  
  .headline {
    max-inline-size: calc(var(--layout-prose-max) * 1.5);
  }
  
  .grid {
    display: grid;
    gap: var(--space-l);
    margin-block-start: var(--space-l);
  }
  
  .story p + p {
    margin-block-start: var(--space-m);
  }
  
  @media (width >= 64rem) {
    .grid {
      grid-template-areas:
        'story stat'
        'role stat';
      grid-template-columns: minmax(0, 5fr) minmax(0, 4fr);
      column-gap: var(--space-2xl);
      align-items: start;
    }
  
    .story {
      grid-area: story;
    }
  
    .record-count {
      grid-area: stat;
    }
  
    .role {
      grid-area: role;
    }
  }
  
  @media print {
    .beat {
      padding-block: var(--space-s);
    }
  
    .headline {
      font-size: var(--size-h4);
    }
  
    .grid {
      display: block;
      margin-block-start: var(--space-s);
      font-size: var(--size-small);
    }
  
    .record-count,
    .role {
      margin-block-start: var(--space-s);
    }
  }
</style>
