---
import Band from '@src/components/Band.astro';
import BeatKicker from '@src/components/experience/BeatKicker.astro';
import RoleLine from '@src/components/experience/RoleLine.astro';
import type resume from '@src/data/resume.json';

interface Props {
  job: (typeof resume.work)[number];
  number: string;
}

const { job, number } = Astro.props;
const id = `job-${number}`;
---

<Band ground="body" labelledby={id} class="beat">
  <div class="container">
    <hgroup class="heading">
      <BeatKicker number={number} place={job.location} start={job.startDate} end={job.endDate} />
      <h2 id={id} class="headline">
        <span class="vh">{`${job.name}: `}</span>A price list that was being re-calibrated by hand.
      </h2>
    </hgroup>

    <div class="grid">
      <div class="story">
        <p>
          Component costs moved with supplier data, and somebody adjusted them by hand. I replaced
          that with an ML pricing model fed by the live supplier feed. It was the first time I
          replaced a person’s recurring task with a system, and it’s why I look for that shape
          first. The database under it had outgrown its indexes, so I reindexed it and added
          automated validation, which is what made the query times usable.
        </p>
      </div>
      <RoleLine
        class="role"
        position={job.position}
        company={job.name}
        stack={['Python', 'SQL', 'ML']}
      />
    </div>
  </div>
</Band>

<style>
  .heading {
    display: grid;
    gap: var(--space-s);
  }
  
  .headline {
    max-inline-size: calc(var(--layout-prose-max) * 1.5);
  }
  
  .grid {
    display: grid;
    gap: var(--space-l);
    margin-block-start: var(--space-l);
  }
  
  .story p + p {
    margin-block-start: var(--space-m);
  }
  
  @media (width >= 64rem) {
    .grid {
      grid-template-areas:
        'story'
        'role';
      column-gap: var(--space-2xl);
      align-items: start;
    }
  
    .story {
      grid-area: story;
    }
  
    .role {
      grid-area: role;
    }
  }
  
  @media print {
    .beat {
      padding-block: var(--space-s);
    }
  
    .headline {
      font-size: var(--size-h4);
    }
  
    .grid {
      display: block;
      margin-block-start: var(--space-s);
      font-size: var(--size-small);
    }
  
    .record-count,
    .role {
      margin-block-start: var(--space-s);
    }
  }
</style>
