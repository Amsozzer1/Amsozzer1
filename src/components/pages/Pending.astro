---
interface Props {
  class?: string;
}

const { class: className, ...rest } = Astro.props;
---

<p class:list={['pending', className]} {...rest}>Not written up yet.</p>

<style>
  .pending {
    color: var(--fg-caption);
    font-family: var(--font-mono);
    font-size: var(--size-mono);
    line-height: var(--leading-mono);
  }
</style>
