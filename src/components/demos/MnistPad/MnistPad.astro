---
import ComingSoon from '@src/components/demos/ComingSoon.astro';
import {
  sampleBitmap,
  sampleStroke,
  sampleStrokeWidth,
} from '@src/components/demos/MnistPad/_helpers/mnistPad.consts';
import { pixels } from '@src/components/demos/MnistPad/_helpers/mnistPad.functions';
import { facts } from '@src/data/facts';

const { layers, classes, sample } = facts.mnist;
const [side] = layers[0].shape;
const digits = Array.from({ length: classes }, (_, digit) => digit);
const share = (digit: number) => sample.bars.find(bar => bar.digit === digit)?.share ?? 0;
const preview = pixels(sampleBitmap);
const box = `0 0 ${side} ${side}`;
---

{/* @TODO: wire the real MNIST pad (pointer drawing, the trained weights, the hand-written forward pass) when Ahmed brings the finished demo */}
<figure class="pad on-ink">
  <figcaption class="pad-bar">
    <span class="pad-title">draw a digit here — click and drag</span>
    <span class="pad-meta">{side} × {side} input</span>
  </figcaption>

  <div class="pad-body">
    <div class="pad-draw">
      <svg class="surface" viewBox={box} aria-hidden="true">
        <defs>
          <pattern id="pad-grid" width="1" height="1" patternUnits="userSpaceOnUse">
            <path class="grid-line" d="M1 0V1M0 1H1"></path>
          </pattern>
        </defs>
        <rect width={side} height={side} fill="url(#pad-grid)"></rect>
        <path class="stroke" d={sampleStroke} stroke-width={sampleStrokeWidth}></path>
      </svg>
      <div class="tools">
        <button type="button" class="tool" disabled aria-describedby="pad-status">Clear</button>
        <button type="button" class="tool" disabled aria-describedby="pad-status">Undo</button>
      </div>
    </div>

    <div class="pad-read">
      <p class="read-label">prediction</p>
      <p class="read-digit">
        {sample.digit}
        <span class="read-aside">a drawn sample, not a live reading</span>
      </p>
      <ol class="confidence" aria-hidden="true">
        {digits.map(digit => <li class:list={['score', { top: digit === sample.digit }]}>
          <span class="score-digit">{digit}</span>
          <svg class="score-bar"><rect width={`${share(digit) * 100}%`} height="100%"></rect></svg>
        </li>)}
      </ol>
    </div>

    <div class="sees">
      <svg class="sees-grid" viewBox={box} aria-hidden="true">
        {preview.map(pixel => (
          <rect
            class="sees-pixel"
            x={pixel.x}
            y={pixel.y}
            width="1"
            height="1"
            fill-opacity={pixel.ink}
          ></rect>
        ))}
      </svg>
      <p class="sees-label">what the network sees — {side} × {side}, centred on its own ink</p>
    </div>
  </div>

  <div class="samples">
    <p id="pad-samples" class="samples-label">try a sample digit</p>
    <div class="samples-row" role="group" aria-labelledby="pad-samples">
      {digits.map(digit => <button
        type="button"
        class="sample"
        disabled
        aria-describedby="pad-status"
      >
        {digit}
      </button>)}
    </div>
  </div>

  <ComingSoon id="pad-status" class="pad-status">
    The trained network arrives with the demo. Nothing here reads what you draw yet.
  </ComingSoon>
</figure>

<style>
  .pad {
    container-type: inline-size;
    padding: var(--space-m);
    background-color: var(--color-ground-ink);
  }
  
  .pad-bar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-s);
    align-items: baseline;
    justify-content: space-between;
    padding-block-end: var(--space-s);
    border-block-end: var(--rule-figure) solid var(--color-amber);
    font-family: var(--font-mono);
    font-size: var(--size-mono);
    line-height: var(--leading-mono);
  }
  
  .pad-title {
    color: var(--fg);
  }
  
  .pad-meta {
    color: var(--fg-caption);
  }
  
  .pad-body {
    display: grid;
    gap: var(--space-m);
    margin-block-start: var(--space-m);
  }
  
  .surface {
    display: block;
    inline-size: 100%;
    max-inline-size: calc(var(--space-4xl) * 2);
    margin-inline: auto;
    aspect-ratio: 1;
    background-color: var(--color-ground-ink-raised);
    outline: var(--rule-figure) dashed var(--color-amber);
    outline-offset: var(--space-3xs);
  }
  
  .grid-line {
    fill: none;
    stroke: var(--color-rule-ink);
    stroke-width: var(--rule-row);
    vector-effect: non-scaling-stroke;
  }
  
  .stroke {
    fill: none;
    stroke: var(--fg);
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  
  .tools {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-block-start: var(--space-m);
  }
  
  .tool {
    min-block-size: var(--layout-target-min);
    padding-inline: var(--space-m);
    border: var(--rule-row) solid var(--rule-color);
    background: none;
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: var(--size-mono);
    line-height: var(--leading-mono);
    cursor: not-allowed;
  }
  
  .read-label,
  .sees-label,
  .samples-label {
    color: var(--fg-caption);
    font-family: var(--font-mono);
    font-size: var(--size-mono-small);
    line-height: var(--leading-mono);
  }
  
  .read-digit {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-s);
    align-items: baseline;
    color: var(--fg);
    font-family: var(--font-display);
    font-size: var(--size-display);
    font-weight: 700;
    line-height: 1;
    letter-spacing: var(--tracking-display);
  }
  
  .read-aside {
    color: var(--fg-caption);
    font-family: var(--font-mono);
    font-size: var(--size-mono-small);
    font-weight: 400;
    letter-spacing: normal;
  }
  
  .confidence {
    display: grid;
    gap: var(--space-3xs);
    margin-block-start: var(--space-m);
    padding: 0;
    border-block-start: var(--rule-row) solid var(--rule-color);
    padding-block-start: var(--space-s);
    list-style: none;
  }
  
  .score {
    display: flex;
    gap: var(--space-2xs);
    align-items: center;
    color: var(--fg-caption);
    font-family: var(--font-mono);
    font-size: var(--size-mono-small);
    line-height: var(--leading-mono);
  }
  
  .score.top {
    color: var(--fg);
  }
  
  .score-bar {
    flex-grow: 1;
    block-size: var(--space-2xs);
    fill: var(--color-text-on-ink-subtle);
  }
  
  .score.top .score-bar {
    fill: var(--color-amber);
  }
  
  .sees-grid {
    display: block;
    inline-size: 100%;
    max-inline-size: calc(var(--space-4xl) + var(--space-l));
    aspect-ratio: 1;
    background-color: var(--color-ground-ink-raised);
  }
  
  .sees-pixel {
    fill: var(--fg);
  }
  
  .sees-label {
    margin-block-start: var(--space-2xs);
  }
  
  .samples {
    margin-block-start: var(--space-m);
    padding-block-start: var(--space-m);
    border-block-start: var(--rule-row) solid var(--rule-color);
  }
  
  .samples-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-block-start: var(--space-2xs);
  }
  
  .sample {
    min-inline-size: var(--layout-target-min);
    min-block-size: var(--layout-target-min);
    border: var(--rule-row) solid var(--rule-color);
    background: none;
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: var(--size-mono);
    cursor: not-allowed;
  }
  
  .pad-status {
    margin-block-start: var(--space-m);
    padding-block-start: var(--space-m);
    border-block-start: var(--rule-row) solid var(--rule-color);
  }
  
  /* The panel is sized by its own content box, so the pad lays itself out against its own width. */
  @container (width >= 17rem) {
    .pad-body {
      grid-template-areas:
        'draw read'
        'sees read';
      grid-template-columns: calc(var(--space-4xl) + var(--space-l)) minmax(0, 1fr);
      column-gap: var(--space-m);
      align-items: start;
    }
  
    .pad-draw {
      grid-area: draw;
    }
  
    .pad-read {
      grid-area: read;
    }
  
    .sees {
      grid-area: sees;
    }
  }
  
  @container (width >= 30rem) {
    .pad-body {
      grid-template-columns: calc(var(--space-4xl) * 2) minmax(0, 1fr);
      column-gap: var(--space-l);
    }
  }
</style>
