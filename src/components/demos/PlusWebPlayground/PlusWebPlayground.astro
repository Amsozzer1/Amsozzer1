---
import {
  examples,
  methodTone,
  methods,
  sampleRequest,
  source,
} from '@src/components/demos/PlusWebPlayground/_helpers/plusWebPlayground.consts';
import { routesFrom } from '@src/components/demos/PlusWebPlayground/_helpers/plusWebPlayground.functions';
import plusweb from '@src/data/plusweb.json';

const routes = routesFrom(source);
---

<plusweb-playground class="playground" data-module={plusweb.base}>
  <form class="request" data-pw="form">
    <label class="vh" for="playground-method">Method</label>
    <select id="playground-method" class="method" data-pw="method">
      {methods.map(method => <option value={method} selected={method === sampleRequest.method}>
        {method}
      </option>)}
    </select>
    <label class="vh" for="playground-path">Path</label>
    <input
      id="playground-path"
      class="path"
      type="text"
      value={sampleRequest.path}
      data-pw="path"
    />
    <button type="submit" class="send">Match</button>
  </form>

  <p class="result" data-pw="result" role="status">
    <span class="match" data-pw="match">send a path</span>
    <span class="ns" data-pw="ns"></span>
  </p>

  <p class="examples">
    try
    {examples.map(({ method, path }, index) => (
      <>
        {index > 0 && ', '}
        <button type="button" class="example" data-method={method} data-path={path}>{path}</button>
      </>
    ))}
  </p>

  <div class="routes">
    <label class="bar" for="playground-source">
      <span>routes</span>
      <span class="count" data-pw="count">{routes.length} routes</span>
    </label>
    <textarea
      id="playground-source"
      class="source on-ink"
      rows="6"
      spellcheck="false"
      data-pw="source"
    >{source}</textarea>
  </div>

  <details class="folded">
    <summary>the trie these build</summary>
    <div class="trie" data-pw="trie">
      <ul>
        {routes.map(route => <li>
          <span class:list={['node', `tone-${methodTone[route.method]}`]}>{route.method}</span>
          <span class="node">{route.pattern}</span>
        </li>)}
      </ul>
    </div>
  </details>

  <p class="note" data-pw="note">
    The route lines are compiled by the real router; handler names are decoration.
  </p>
</plusweb-playground>

<script>
  import '@src/components/demos/PlusWebPlayground/PlusWebPlayground';
</script>

<style>
  .playground {
    display: grid;
    gap: var(--space-m);
  }
  
  .panes {
    display: grid;
    gap: var(--space-m);
    align-items: start;
  }
  
  .pane {
    min-inline-size: 0;
    margin: 0;
  }
  
  .bar {
    display: flex;
    gap: var(--space-s);
    align-items: baseline;
    justify-content: space-between;
    padding-block-end: var(--space-2xs);
    color: var(--color-text-caption);
    font-family: var(--font-mono);
    font-size: var(--size-mono-small);
    line-height: var(--leading-mono);
  }
  
  .count[data-problem='true'] {
    color: var(--color-error);
  }
  
  .source {
    display: block;
    inline-size: 100%;
    padding: var(--space-m);
    border: 0;
    background-color: var(--color-ground-ink);
    color: var(--fg);
    font-family: var(--font-mono);
  
    /* 16px minimum, so iOS does not zoom when the field takes focus. */
    font-size: var(--size-body);
    line-height: var(--leading-code);
    resize: vertical;
  }
  
  .trie {
    padding-block-start: var(--space-s);
    font-family: var(--font-mono);
    font-size: var(--size-mono);
    line-height: var(--leading-mono);
  }
  
  .trie :global(ul) {
    margin: 0;
    padding-inline-start: var(--space-m);
    border-inline-start: var(--rule-row) solid var(--color-rule-light);
    list-style: none;
  }
  
  .trie > :global(ul) {
    padding-inline-start: 0;
    border-inline-start: 0;
  }
  
  .trie :global(li) {
    padding-block: var(--space-3xs);
  }
  
  .trie :global(.node) {
    color: var(--color-text);
  }
  
  .trie :global(.param) {
    color: var(--color-method-post);
    font-weight: 700;
  }
  
  .tone-get {
    color: var(--color-method-get);
  }
  
  .tone-post {
    color: var(--color-method-post);
  }
  
  .tone-delete {
    color: var(--color-method-delete);
  }
  
  .request {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    min-inline-size: 0;
  }
  
  .method,
  .path,
  .send {
    min-block-size: var(--layout-target-min);
    font-family: var(--font-mono);
    font-size: var(--size-body);
    line-height: var(--leading-mono);
  }
  
  .method {
    padding-inline: var(--space-s);
    border: var(--rule-row) solid var(--color-rule-light);
    background: none;
    color: var(--color-text);
  }
  
  .path {
    flex: 1 1 calc(var(--space-4xl) + var(--space-2xl));
    min-inline-size: 0;
    padding-inline: var(--space-s);
    border: var(--rule-row) solid var(--color-text);
    background-color: var(--color-ground-paper);
    color: var(--color-text);
  }
  
  .send {
    padding-inline: var(--space-l);
    border: var(--rule-row) solid var(--color-amber);
    background-color: var(--color-amber);
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: var(--size-small);
    font-weight: 600;
  }
  
  .result {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-m);
    align-items: baseline;
    justify-content: space-between;
    padding-block: var(--space-s);
    border-block-start: var(--rule-figure) solid var(--color-amber);
    font-family: var(--font-mono);
    font-size: var(--size-h3);
    line-height: var(--leading-mono);
  }
  
  .ns {
    color: var(--color-text-caption);
    font-size: var(--size-mono);
  }
  
  .folded {
    color: var(--color-text-caption);
    font-family: var(--font-mono);
    font-size: var(--size-mono-small);
    line-height: var(--leading-mono);
  }
  
  .folded summary {
    min-block-size: var(--layout-target-min);
    padding-block: var(--space-2xs);
    cursor: pointer;
  }
  
  .result[data-matched='false'] {
    border-block-start-color: var(--color-rule-light);
    color: var(--color-text-caption);
  }
  
  .examples,
  .note {
    color: var(--color-text-caption);
    font-family: var(--font-mono);
    font-size: var(--size-mono-small);
    line-height: var(--leading-mono);
  }
  
  .example {
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-text);
    font: inherit;
    text-decoration: underline;
  }
</style>
