---
import Band from '@src/components/Band.astro';
import SectionHeading from '@src/components/SectionHeading.astro';
import { blurbs } from '@src/components/home/_helpers/projects.consts';
import { listedProjects } from '@src/data/projects';

const bare = (url: string) => url.replace(/^https:\/\/(www\.)?/, '');
---

<Band ground="body" id="projects" labelledby="projects-title" class="projects">
  <div class="container">
    <SectionHeading class="heading" kicker="projects" id="projects-title" title="On my own time." />

    <ol class="rows">
      {listedProjects.map(project => <li class="row">
        <h3 class="name">{project.name}</h3>
        <p class="blurb">{blurbs[project.slug] ?? project.tagline}</p>
        <p class="links">
          <a href={project.path}>details <span aria-hidden="true">→</span></a>
          <a href={project.repo}>{bare(project.repo)} <span aria-hidden="true">↗</span></a>
        </p>
      </li>)}
    </ol>
  </div>
</Band>

<style>
  .heading {
    max-inline-size: var(--layout-prose-max);
  }
  
  .rows {
    margin: 0;
    margin-block-start: var(--space-xl);
    padding: 0;
    border-block-start: var(--rule-row) solid var(--rule-color);
    list-style: none;
  }
  
  .row {
    padding-block: var(--space-l);
    border-block-end: var(--rule-row) solid var(--rule-color);
  }
  
  .name {
    font-family: var(--font-display);
    font-size: var(--size-h3);
    line-height: var(--leading-tight);
  }
  
  .blurb {
    max-inline-size: var(--layout-prose-max);
    margin-block-start: var(--space-xs);
    color: var(--fg-body);
  }
  
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m);
    margin-block-start: var(--space-s);
    font-family: var(--font-mono);
    font-size: var(--size-link);
    line-height: var(--leading-mono);
  }
  
  .links a:hover {
    text-decoration-color: var(--color-amber);
  }
  
  @media (width >= 64rem) {
    .row {
      display: grid;
      grid-template-columns: minmax(0, 4fr) minmax(0, 9fr);
      column-gap: var(--space-2xl);
    }
  
    .links {
      grid-column: 2;
    }
  }
</style>
