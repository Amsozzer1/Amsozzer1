---
import Band from '@src/components/Band.astro';
import SectionHeading from '@src/components/SectionHeading.astro';
import Terminal from '@src/components/Terminal.astro';
import ProjectRow from '@src/components/home/ProjectRow.astro';
import TerminalLines from '@src/components/home/TerminalLines.astro';
import { curlSession, printerReport } from '@src/components/home/_helpers/projects.consts';
import type { Line } from '@src/components/home/_helpers/terminalLines.functions';
import { facts } from '@src/data/facts';
import { listedProjects, type ProjectSlug } from '@src/data/projects';

const { mqtt } = facts.amsx;

interface Panel {
  note: string;
  title: string;
  meta: string;
  lines: Line[];
}

const panels: Partial<Record<ProjectSlug, Panel>> = {
  plusweb: {
    note: 'the timing on that page is measured in your browser, on a port of the same trie, not typed in by me.',
    title: `curl — localhost:${facts.plusweb.port}`,
    meta: 'keep-alive',
    lines: curlSession,
  },
  'ams-x': {
    note: 'nothing moves until the printer’s own report agrees with the plan.',
    title: mqtt.topic,
    meta: `mqtt · tls ${mqtt.port}`,
    lines: printerReport,
  },
};

// A project without a panel simply doesn't appear here, so the list stays the single source.
const rows = listedProjects.flatMap(project => {
  const panel = panels[project.slug];
  return panel ? [{ project, panel }] : [];
});
---

<Band ground="body" id="projects" labelledby="projects-title" class="projects">
  <div class="container">
    <div class="head">
      <SectionHeading
        class="heading"
        kicker="projects"
        id="projects-title"
        title="On my own time."
      />
    </div>

    {rows.map(({ project, panel }, index) => <ProjectRow
      project={project}
      mark="tape"
      flip={index % 2 === 1}
      note={panel.note}
    >
      <Terminal title={panel.title} meta={panel.meta}>
        <TerminalLines lines={panel.lines} />
      </Terminal>
    </ProjectRow>)}
  </div>
</Band>

<style>
  .projects {
    padding-block-end: 0;
  }
  
  .head {
    display: grid;
    gap: var(--space-m);
    margin-block-end: var(--space-xl);
  }
  
  .heading {
    max-inline-size: var(--layout-prose-max);
  }
  
  @media (width >= 64rem) {
    .head {
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: var(--space-xl);
      align-items: end;
    }
  }
</style>
