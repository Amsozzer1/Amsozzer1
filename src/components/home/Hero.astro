---
import AtWork from '@src/components/home/AtWork.astro';
import Band from '@src/components/Band.astro';
import { site } from '@src/data/site';

const headline = ['I write', 'the layer', 'most people', 'import.'];

const actions = [
  { href: site.resumePdf, label: 'resume (pdf)' },
  { href: site.links.github, label: 'github' },
  { href: site.links.linkedin, label: 'linkedin' },
];
---

<Band ground="paper" graph labelledby="hero-title" class="hero" data-motion-hero>
  <div class="container layout">
    <div class="copy">
      <h1 id="hero-title" class="vh">{site.name} · {site.jobTitle}</h1>
      <p class="display tagline" data-motion-stagger>
        {headline.map(line => <span class="line" data-motion>{line}</span>)}
      </p>
      <p class="lead">{site.description}</p>
      <p class="availability">
        {site.availability.label}
        <span aria-hidden="true">·</span> {site.location.city}, {site.location.region}
        <span aria-hidden="true">·</span> {site.availability.relocation}
      </p>
      <ul class="actions">
        <li>
          <a class="email" href={`mailto:${site.email}?subject=Hi%20Ahmed`}>Email me</a>
        </li>
        {actions.map(({ href, label }) => <li>
          <a class="action" href={href}>{label}</a>
        </li>)}
      </ul>
    </div>

    <AtWork />
  </div>
</Band>

<style>
  /* The fold is the viewport: the band fills what is under the header, content centred. */
  .hero {
    display: grid;
    align-content: center;
    min-block-size: calc(100svh - var(--layout-header-height) - var(--layout-amber-band));
    padding-block: var(--space-xl);
  }
  
  .layout {
    display: grid;
    row-gap: var(--space-xl);
  }
  
  /* On a phone the lines wrap as ordinary text; the four forced lines are a desktop shape. */
  .tagline .line {
    display: inline;
  }
  
  .tagline .line + .line::before {
    content: ' ';
  }
  
  .lead {
    max-inline-size: var(--layout-prose-max);
    margin-block-start: var(--space-m);
  }
  
  .availability {
    margin-block-start: var(--space-s);
    color: var(--fg-caption);
    font-family: var(--font-mono);
    font-size: var(--size-mono-small);
    line-height: var(--leading-mono);
  }
  
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m);
    align-items: center;
    margin-block-start: var(--space-l);
    padding: 0;
    list-style: none;
  }
  
  /* The one filled control on the page. */
  .email {
    display: inline-block;
    padding: var(--space-s) var(--space-m);
    background-color: var(--color-amber);
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: var(--size-small);
    font-weight: 600;
    line-height: var(--leading-tight);
    text-decoration: none;
  }
  
  .email:hover {
    text-decoration-line: underline;
  }
  
  .action {
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: var(--size-link);
    line-height: var(--leading-mono);
    text-underline-offset: 0.3em;
  }
  
  .action:hover {
    text-decoration-color: var(--color-amber);
  }
  
  @media (width >= 64rem) {
    .layout {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      column-gap: var(--space-2xl);
      align-items: start;
    }
  
    .tagline .line {
      display: block;
    }
  
    .tagline .line + .line::before {
      content: none;
    }
  }
</style>
