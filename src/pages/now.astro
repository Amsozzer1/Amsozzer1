---
import FactList from '@src/components/pages/FactList.astro';
import PageHero from '@src/components/pages/PageHero.astro';
import PageSection from '@src/components/pages/PageSection.astro';
import Pending from '@src/components/pages/Pending.astro';
import { routes } from '@src/data/routes';
import { site } from '@src/data/site';
import Base from '@src/layouts/Base.astro';
import { lastModified, monthYearLong } from '@src/lib/dates';
import { routeSeo } from '@src/lib/seo/meta';

const updated = lastModified(...routes['/now'].sources);
const { since, label } = site.availability;
const sinceLabel = monthYearLong(since);
---

<Base seo={routeSeo('/now')}>
  <PageHero kicker="now" title="What I am working on this month." updated={updated}>
    {/* @TODO: Ahmed's own standfirst for /now */}
    <p>
      What has my attention this month, at work and on my own time. The date above is the last time
      it changed.
    </p>
  </PageHero>

  <PageSection id="at-work" title="At work">
    {/* @TODO: this month at FYCLabs — what is being built, clients by category only, never named */}
    <Pending />
  </PageSection>

  <PageSection id="own-time" title="On my own time" ground="paper">
    {/* @TODO: this month on PlusWeb, AMS-X, MNIST and the writing */}
    <Pending />
  </PageSection>

  <PageSection id="availability" title="Availability">
    <FactList>
      <div>
        <dt>status</dt>
        <dd>{label}</dd>
      </div>
      <div>
        <dt>from</dt>
        <dd><time datetime={since}>{sinceLabel}</time></dd>
      </div>
      <div>
        <dt>work</dt>
        <dd>Product and systems work.</dd>
      </div>
      <div>
        <dt>where</dt>
        <dd>{site.location.city}, {site.location.region}, or remote.</dd>
      </div>
      <div>
        <dt>contact</dt>
        <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
      </div>
    </FactList>
  </PageSection>
</Base>
