{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "node_modules", "worker", "public/demos", "public/lintel"],
  "compilerOptions": {
    "paths": {
      "@src/*": ["./src/*"]
    },
    "allowImportingTsExtensions": true,
    "types": ["node"]
  }
}
